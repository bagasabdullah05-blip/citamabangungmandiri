---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { certificates } from '../../data/company';
import { site } from '../../data/site';

const grouped = [
  {
    icon: 'certificate',
    title: 'Izin Usaha',
    items: certificates.filter((cert) =>
      ['Nomor Induk Berusaha (NIB)', 'Izin Usaha Konstruksi'].includes(cert.name),
    ),
  },
  {
    icon: 'building',
    title: 'Badan Usaha',
    items: certificates.filter((cert) =>
      ['Akta Pendirian Perseroan', 'Sertifikat Badan Usaha (SBU)'].includes(cert.name),
    ),
  },
  {
    icon: 'award',
    title: 'Identitas Pajak',
    items: certificates.filter((cert) => cert.name === 'NPWP Perusahaan'),
  },
];
---

<BaseLayout
  title="Legalitas"
  description="Legalitas dan perizinan PT. Citra Bangun Mandiri: akta pendirian, NIB, izin usaha konstruksi, SBU, dan NPWP perusahaan."
  section="profil"
>
  <PageHero
    eyebrow="Legalitas"
    title="Perizinan Perusahaan"
    description="Semua pekerjaan kami dikerjakan melalui badan usaha resmi dengan izin yang masih berlaku."
    primaryLabel="Hubungi Kami"
    primaryHref="/kontak/"
    secondaryLabel="Tentang Kami"
    secondaryHref="/profil/tentang/"
  />

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="prose">
          <SectionHead
            eyebrow="Dokumen"
            title="Izin yang Kami Miliki"
            description="Berikut daftar izin dan sertifikat yang menjadi dasar kegiatan usaha kami."
          />
          <p>
            Sebagai badan usaha berbentuk perseroan terbatas, kami menjalankan seluruh
            kegiatan melalui struktur perusahaan yang jelas. Dokumen izin dapat
            diperlihatkan langsung kepada klien saat dilakukan kerja sama.
          </p>
        </div>
        <aside class="identity">
          <h3 class="identity__title">Identitas Perusahaan</h3>
          <dl class="identity__list">
            <div>
              <dt>Nama Badan Usaha</dt>
              <dd>{site.legalName}</dd>
            </div>
            <div>
              <dt>Bentuk</dt>
              <dd>Perseroan Terbatas</dd>
            </div>
            <div>
              <dt>Tahun Berdiri</dt>
              <dd>2015</dd>
            </div>
            <div>
              <dt>Alamat</dt>
              <dd>{site.address}</dd>
            </div>
            <div>
              <dt>Bidang Usaha</dt>
              <dd>Konstruksi dan manufaktur herbal</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Rincian"
        title="Daftar Perizinan"
        description="Nomor dan tahun penerbitan dapat disesuaikan dengan dokumen asli perusahaan."
      />
      <div class="grid grid--3">
        {
          grouped.map((group) => (
            <div class="group">
              <div class="group__head">
                <span class="group__icon">
                  <Icon name={group.icon} size={20} />
                </span>
                <h3>{group.title}</h3>
              </div>
              <div class="table-wrap">
                <table>
                  <caption class="visually-hidden">{group.title}</caption>
                  <thead>
                    <tr>
                      <th scope="col">Dokumen</th>
                      <th scope="col">Penerbit</th>
                      <th scope="col">Tahun</th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      group.items.map((item) => (
                        <tr>
                          <td>{item.name}</td>
                          <td>{item.issuer}</td>
                          <td>{item.year}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Butuh Salinan Dokumen?"
    description="Dokumen perizinan perusahaan dapat kami siapkan atas permintaan untuk keperluan tender atau kerja sama."
    primaryLabel="Minta Dokumen"
    primaryHref="/kontak/"
    secondaryLabel="Tentang Kami"
    secondaryHref="/profil/tentang/"
  />
</BaseLayout>

<style>
  .split {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  @media (min-width: 62rem) {
    .split {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .identity {
    padding: 1.75rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .identity__title {
    font-size: 1.0625rem;
    margin-bottom: 1.125rem;
  }

  .identity__list {
    margin: 0;
    display: grid;
    gap: 0.875rem;
  }

  .identity__list > div {
    display: grid;
    gap: 0.125rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px dashed var(--line-strong);
  }

  .identity__list > div:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .identity__list dt {
    font-size: 0.8125rem;
    color: var(--ink-4);
  }

  .identity__list dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
    font-weight: 500;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .group__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .group__head h3 {
    font-size: 1.0625rem;
  }

  .group__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    background: var(--brand-50);
    color: var(--brand);
    flex-shrink: 0;
  }
</style>