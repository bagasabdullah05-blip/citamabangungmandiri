---
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import CbmIdentity from '../components/CbmIdentity.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { services, stats, values } from '../data/company';

const dualCards = [
  {
    icon: 'building',
    title: 'Profil Perusahaan',
    description:
      'Sejarah, visi, misi, dan nilai-nilai kami.',
    href: '/profil/',
    cta: 'Pelajari Profil',
    color: 'var(--brand)',
    soft: 'var(--brand-50)',
  },
  {
    icon: 'leaf',
    title: 'Maklon Herbal',
    description:
      'Layanan manufaktur produk herbal untuk brand Anda: formulasi, produksi, pengemasan, dan izin edar.',
    href: '/maklon/',
    cta: 'Lihat Layanan',
    color: '#7c2d12',
    soft: '#fff7ed',
  },
];
---

<BaseLayout
  title={site.name}
  description="PT. Citra Bangun Mandiri adalah perusahaan herbal yang memproduksi produk herbal berkualitas dan menyediakan jasa maklon untuk brand Anda."
>
  <PageHero
    eyebrow="PT. Citra Bangun Mandiri"
    title="Mitra Herbal yang Terpercaya"
    description="PT. Citra Bangun Mandiri adalah perusahaan herbal yang memproduksi produk herbal berkualitas dan menyediakan jasa maklon untuk brand lain."
    primaryLabel="Tentang Perusahaan"
    primaryHref="/profil/"
    secondaryLabel="Layanan Maklon Herbal"
    secondaryHref="/maklon/"
    points={['Private label herbal', 'OEM dan ODM', 'Izin BPOM', 'Izin P-IRT']}
  />

  <CbmIdentity />


  <section class="section section--soft">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Angka Singkat"
        title="Pengalaman yang Terukur"
        description="Sedikit angka untuk gambaran skala pekerjaan kami selama ini."
      />
      <div class="stats">
        {
          stats.map((stat) => (
            <div class="stats__item">
              <span class="stats__value">{stat.value}</span>
              <span class="stats__label">{stat.label}</span>
              {stat.description && <span class="stats__desc">{stat.description}</span>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Profil Perusahaan"
        title="Perusahaan Herbal dan Mitra Maklon"
        description="Sejarah, visi, misi, dan nilai-nilai kami."
      />
      <div class="grid grid--2">
        {
          dualCards.map((card) => (
            <article class="dual" style={`--card-color:${card.color}; --card-soft:${card.soft}`}>
              <div class="dual__icon">
                <Icon name={card.icon} size={26} />
              </div>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <a href={card.href} class="dual__cta">
                {card.cta}
                <Icon name="arrow" size={18} />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Layanan Maklon"
        title="Empat Model Kerja Sama"
        description="Pilih sesuai kebutuhan Anda: dari produksi dengan merek sendiri sampai kita yang menyiapkan ide produk."
      />
      <div class="grid grid--2">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Cara Kerja Kami"
        title="Nilai yang Kami Pegang"
        description="Empat hal yang tidak kami kompromikan, karena itu menentukan hasil akhir pekerjaan."
      />
      <div class="grid grid--4">
        {
          values.map((value, index) => (
            <div class="value">
              <span class="value__num">{String(index + 1).padStart(2, '0')}</span>
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Mau Berdiskusi Kebutuhan Anda?"
    description="Sampaikan kebutuhan produk herbal Anda. Tim kami akan menghubungi Anda dengan estimasi dan langkah selanjutnya."
    primaryLabel="Hubungi Kami"
    primaryHref="/kontak/"
    secondaryLabel="Lihat Layanan"
    secondaryHref="/maklon/layanan/"
  />
</BaseLayout>

<style>
  .dual {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .dual:hover {
    border-color: var(--card-color);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .dual__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius);
    background: var(--card-soft);
    color: var(--card-color);
    margin-bottom: 1.25rem;
  }

  .dual h3 {
    margin-bottom: 0.5rem;
  }

  .dual p {
    color: var(--ink-3);
    margin-bottom: 1.5rem;
  }

  .dual__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--card-color);
  }

  .dual__cta :global(svg) {
    transition: transform var(--transition);
  }

  .dual__cta:hover :global(svg) {
    transform: translateX(4px);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
  }

  .stats__item {
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .stats__value {
    display: block;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--brand);
    line-height: 1.1;
  }

  .stats__label {
    display: block;
    margin-top: 0.375rem;
    font-weight: 600;
    color: var(--ink);
  }

  .stats__desc {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .value {
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .value__num {
    display: block;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--brand);
    margin-bottom: 0.75rem;
  }

  .value h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.375rem;
  }

  .value p {
    font-size: 0.875rem;
    color: var(--ink-3);
  }
</style>
