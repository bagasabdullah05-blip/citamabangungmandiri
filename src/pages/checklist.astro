---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { checklistGroups, checklistMeta } from '../data/checklist';
---

<BaseLayout
  title="Daftar Isian"
  description="Daftar lengkap data, gambar, dan akun yang perlu diisi sebelum website PT. Citra Bangun Mandiri dipublikasikan."
>
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__inner">
      <p class="hero__badge">Internal</p>
      <h1>Yang Perlu Anda Isi Sebelum Luncur</h1>
      <p class="hero__lead">
        Seluruh isi website saat ini masih data contoh. Centang setiap item setelah Anda
        menyediakannya, lalu kirimkan file kepada pengelola website untuk dipasang.
      </p>

      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value" data-progress-value>0</span>
          <span class="hero__stat-label">dari {checklistMeta.total} selesai</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{checklistMeta.required}</span>
          <span class="hero__stat-label">item wajib diisi</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">7</span>
          <span class="hero__stat-label">kelompok data</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <nav class="toc" aria-label="Daftar kelompok isian">
        <p class="toc__title">Kelompok Data</p>
        <ul role="list" class="toc__list">
          {
            checklistGroups.map((group) => (
              <li>
                <a href={`#${group.id}`}>
                  <span class:list={['toc__dot', `toc__dot--${group.tone}`]} aria-hidden="true"></span>
                  {group.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    checklistGroups.map((group) => (
      <section class="section section--group" id={group.id}>
        <div class="container">
          <div class:list={['group', `group--${group.tone}`]}>
            <div class="group__head">
              <span class="group__icon">
                <Icon name={group.icon} size={24} />
              </span>
              <div>
                <h2>{group.title}</h2>
                <p>{group.intro}</p>
              </div>
              <span class="group__count">
                {group.items.length} item
              </span>
            </div>

            <ul role="list" class="items">
              {group.items.map((item, index) => (
                <li class="item">
                  <label class="item__label">
                    <input
                      type="checkbox"
                      class="item__check"
                      data-check
                      value={`${group.id}-${index}`}
                    />
                    <span class="item__body">
                      <span class="item__name">
                        {item.label}
                        {item.required && <span class="item__req">Wajib</span>}
                      </span>
                      <span class="item__hint">{item.hint}</span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--soft">
    <div class="container">
      <div class="note">
        <span class="note__icon">
          <Icon name="bulb" size={24} />
        </span>
        <div>
          <h2>Kalau Tidak Punya Semua Data</h2>
          <p>
            Tidak masalah. Kirim yang sudah ada lebih dulu, sisanya akan ditandai sebagai
            data contoh. Yang penting klaim hukum, sertifikasi, dan nomor sertifikat tidak
            ditampilkan sebelum Anda benar-benar memiliki dokumennya.
          </p>
          <p>
            Untuk placeholder yang berupa foto, pakai gambar sementara dengan label
            sementara supaya tidak salah terbaca sebagai foto asli saat situs tayang.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 55%, var(--accent) 100%);
    color: #fff;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.18;
    background-image:
      radial-gradient(circle at 18% 22%, #fff 0, transparent 42%),
      radial-gradient(circle at 82% 78%, #fff 0, transparent 38%);
  }

  .hero__inner {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .hero__badge {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.28);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin-top: 1.25rem;
    color: #fff;
    max-width: 24ch;
  }

  .hero__lead {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.9);
    max-width: 60ch;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .hero__stat {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.2);
  }

  .hero__stat-value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.1;
  }

  .hero__stat-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.85);
  }

  .toc {
    padding: 1.5rem 1.75rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .toc__title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-4);
    margin-bottom: 0.875rem;
  }

  .toc__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .toc__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  .toc__list a:hover {
    color: var(--brand);
  }

  .toc__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .toc__dot--brand {
    background: var(--brand);
  }

  .toc__dot--accent {
    background: var(--accent);
  }

  .toc__dot--silver {
    background: var(--silver);
  }

  .section--group {
    padding-block: clamp(2rem, 4vw, 3rem);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .group {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: #fff;
    border: 1px solid var(--line);
    border-top: 4px solid var(--brand);
    border-radius: var(--radius-lg);
  }

  .group--accent {
    border-top-color: var(--accent);
  }

  .group--silver {
    border-top-color: var(--silver);
  }

  .group__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .group__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: var(--brand-50);
    color: var(--brand);
  }

  .group--accent .group__icon {
    background: var(--accent-50);
    color: var(--accent);
  }

  .group--silver .group__icon {
    background: var(--silver-soft);
    color: var(--silver);
  }

  .group__head h2 {
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
  }

  .group__head p {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--ink-3);
    max-width: 68ch;
  }

  .group__count {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--silver-soft);
    color: var(--silver);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .items {
    display: grid;
    gap: 0;
    margin-top: 0.5rem;
  }

  .item {
    border-bottom: 1px solid var(--line);
  }

  .item:last-child {
    border-bottom: none;
  }

  .item__label {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1rem 0;
    cursor: pointer;
  }

  .item__check {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    accent-color: var(--brand);
    cursor: pointer;
  }

  .group--accent .item__check {
    accent-color: var(--accent);
  }

  .group--silver .item__check {
    accent-color: var(--silver);
  }

  .item__body {
    display: grid;
    gap: 0.25rem;
  }

  .item__name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--ink);
  }

  .item__req {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    background: var(--accent-50);
    color: var(--accent-dark);
    border: 1px solid var(--accent-100);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .item__hint {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .item__check:checked ~ .item__body .item__name,
  .item__check:checked ~ .item__body .item__hint {
    color: var(--ink-4);
    text-decoration: line-through;
  }

  .item__check:checked ~ .item__body .item__name {
    text-decoration-color: var(--ink-4);
  }

  .item__check:checked ~ .item__body .item__hint {
    text-decoration: none;
  }

  .note {
    display: flex;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-lg);
  }

  .note__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: var(--accent-50);
    color: var(--accent);
    flex-shrink: 0;
  }

  .note h2 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .note p {
    font-size: 0.9375rem;
    color: var(--ink-3);
  }

  .note p + p {
    margin-top: 0.75rem;
  }
</style>

<script>
  const checks = Array.from(document.querySelectorAll<HTMLInputElement>('[data-check]'));
  const progressValue = document.querySelector<HTMLElement>('[data-progress-value]');

  const storageKey = 'cbm-checklist';

  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(storageKey) ?? '[]') as string[];
    } catch {
      return [];
    }
  };

  const write = (done: string[]) => {
    try {
      localStorage.setItem(storageKey, JSON.stringify(done));
    } catch {
      return;
    }
  };

  const refresh = () => {
    const done = read();
    checks.forEach((check) => {
      check.checked = done.includes(check.value);
    });
    if (progressValue) progressValue.textContent = String(done.length);
  };

  const update = () => {
    const done = checks.filter((check) => check.checked).map((check) => check.value);
    write(done);
    if (progressValue) progressValue.textContent = String(done.length);
  };

  checks.forEach((check) => check.addEventListener('change', update));
  refresh();
</script>
