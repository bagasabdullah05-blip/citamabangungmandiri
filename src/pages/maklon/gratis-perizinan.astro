---
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import {
  licensingTiers,
  licensingScope,
  licensingConditions,
  objections,
  proofPoints,
  bookingSteps,
} from '../../data/herbal-licensing';

const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(
  'Halo PT. Citra Bangun Mandiri, saya ingin tahu_detail program gratis perizinan untuk order di atas 1.000 pcs.',
)}`;
---

<BaseLayout
  title="Gratis Perizinan"
  description="Order di atas 1.000 pcs, izin BPOM, izin HAKI, dan uji laboratorium kami gratiskan. Anda hanya membayar biaya produksi. Syarat dan detail lengkap."
  section="maklon"
>
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="hero__badge">Program Mitra Borongan</p>
        <h1 class="hero__title">
          Order Di Atas 1.000 Pcs, Perizinan Kami Yang Bayar
        </h1>
        <p class="hero__lead">
          Uji laboratorium, izin BPOM, dan izin HAKI digratiskan penuh. Anda cukup
          membayar biaya produksi. Tanpa biaya perizinan yang tersembunyi di dalam
          invoice.
        </p>

        <ul role="list" class="hero__points">
          <li><Icon name="check" size={16} /> Gratis uji laboratorium</li>
          <li><Icon name="check" size={16} /> Gratis izin BPOM</li>
          <li><Icon name="check" size={16} /> Gratis izin HAKI</li>
        </ul>

        <div class="hero__actions">
          <a href={whatsappHref} class="btn btn--light" target="_blank" rel="noopener">
            Konsultasi Gratis Sekarang
            <Icon name="arrow" size={18} />
          </a>
          <a href="#rincian" class="btn btn--ghost-light">Lihat Rincian Biaya</a>
        </div>

        <p class="hero__note">
          Balasan rata-rata di hari kerja yang sama. Tanpa biaya dan tanpa ikatan.
        </p>
      </div>

      <div class="hero__card">
        <p class="hero__card-label">Simulasi Order 1.200 Pcs</p>
        <div class="hero__card-row">
          <span>Uji laboratorium</span>
          <span class="free">Gratis</span>
        </div>
        <div class="hero__card-row">
          <span>Izin BPOM</span>
          <span class="free">Gratis</span>
        </div>
        <div class="hero__card-row">
          <span>Izin HAKI</span>
          <span class="free">Gratis</span>
        </div>
        <div class="hero__card-row hero__card-row--total">
          <span>Biaya perizinan</span>
          <span class="free">Rp 0</span>
        </div>
        <p class="hero__card-foot">
          Yang Anda bayar hanya bahan baku, kemasan, dan produksi.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Program Perizinan Gratis"
        title="Tiga Level, Satu Aturan Jelas"
        description="Tidak ada biaya perizinan yang muncul di tengah jalan. Semua kami tulis di kontrak sebelum produksi dimulai."
      />
      <div class="grid grid--3">
        {
          licensingTiers.map((tier) => (
            <article class:list={['tier', { 'tier--highlight': tier.highlight }]}>
              {tier.highlight && <span class="tier__flag">Tanpa Biaya Perizinan</span>}
              <p class="tier__name">{tier.tier}</p>
              <p class="tier__range">{tier.range}</p>
              <p class="tier__order small">{tier.order}</p>

              <div class="tier__cost">
                <p class="tier__cost-label">{tier.cost}</p>
                <p class="tier__cost-note">{tier.costNote}</p>
              </div>

              <ul role="list" class="tier__perks">
                {tier.perks.map((perk) => (
                  <li>
                    <Icon name={tier.highlight ? 'check' : 'minus'} size={16} />
                    {perk}
                  </li>
                ))}
              </ul>

              {tier.highlight ? (
                <a
                  class="btn btn--primary btn--block tier__cta"
                  href={whatsappHref}
                  target="_blank"
                  rel="noopener"
                >
                  Amankan Slot Produksi
                  <Icon name="arrow" size={18} />
                </a>
              ) : (
                <a class="btn btn--secondary btn--block tier__cta" href="/kontak/">
                  Tanya Kebutuhan Saya
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft" id="rincian">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Rincian Biaya"
        title="Apa Saja yang Kami Tanggung"
        description="Berlaku khusus untuk order di atas 1.000 unit per varian."
      />
      <div class="grid grid--2">
        {
          licensingScope.map((item) => (
            <article class:list={['card', 'scope', { 'scope--out': !item.covered }]}>
              <div class:list={['scope__icon', { 'scope__icon--out': !item.covered }]}>
                <Icon name={item.icon} size={24} />
              </div>
              <div>
                <div class="scope__head">
                  <h3>{item.title}</h3>
                  <span class:list={['badge', item.covered ? 'badge' : 'badge badge--slate']}>
                    {item.covered ? 'Gratis' : 'Tidak termasuk'}
                  </span>
                </div>
                <p>{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <SectionHead
            eyebrow="Kenapa 1.000 Pcs?"
            title="Hitungan yang Masuk Akal untuk Dua Belah Pihak"
            description="Biaya perizinan itu tetap ada, hanya saja tidak terlalu memberatkan kalau dibagi ke ribuan unit."
          />
          <ul role="list" class="conditions">
            {
              licensingConditions.map((condition) => (
                <li>
                  <Icon name="shield" size={18} />
                  <span>{condition}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <aside class="callout">
          <span class="callout__icon">
            <Icon name="bulb" size={24} />
          </span>
          <h3>Bagaimana kalau order Anda belum sampai 1.000 pcs?</h3>
          <p>
            Tetap bisa produksi. Tim kami tetap membantu pengurusan berkas seperti
            biasanya. Yang berbeda hanya siapa yang menanggung biayanya.
          </p>
          <p>
            Banyak klien kami memulai dari 500 unit, lalu naik ke skala borongan di order
            berikutnya begitu produknya sudah terbukti di pasar.
          </p>
          <a class="btn btn--primary btn--block" href={whatsappHref} target="_blank" rel="noopener">
            Tanya Kebutuhan Saya
          </a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Pertanyaan yang Sering Muncul"
        title="Jawabannya Singkat, Jadi Anda Tidak Perlu Ragu"
        description="Kalau pertanyaan Anda belum ada di sini, tanya langsung lewat WhatsApp."
      />
      <div class="faqs">
        {
          objections.map((item) => (
            <details class="faq">
              <summary>
                <span>{item.q}</span>
                <Icon name="chevron" size={18} class="faq__icon" />
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
      <p class="text-center" style="margin-top: 2rem">
        <a class="btn btn--secondary" href={whatsappHref} target="_blank" rel="noopener">
          Tanya Langsung ke Tim Kami
        </a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        align="center"
        eyebrow="Cara Memulai"
        title="Tiga Langkah, Selesai"
        description="Tidak ada proses yang rumit. Cukup mulai dari satu pesan."
      />
      <div class="grid grid--3">
        {
          bookingSteps.map((item) => (
            <div class="booking">
              <span class="booking__num">{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>

      <div class="proof">
        {
          proofPoints.map((point) => (
            <div class="proof__item">
              <span class="proof__icon">
                <Icon name={point.icon} size={20} />
              </span>
              <div>
                <h3>{point.title}</h3>
                <p>{point.description}</p>
                <a class="proof__link" href={point.href}>
                  {point.action}
                  <Icon name="arrow" size={16} />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Mau Produksi dengan Perizinan Gratis?"
    description="Kirim kebutuhan Anda lewat WhatsApp. Kami balas dengan estimasi biaya produksi, timeline, dan daftar berkas yang perlu Anda siapkan. Gratis, tanpa ikatan."
    note="Balasan rata-rata di hari kerja yang sama. Tanpa biaya dan tanpa ikatan."
    primaryLabel="Konsultasi Gratis via WhatsApp"
    primaryHref={whatsappHref}
    primaryExternal
    secondaryLabel="Lihat Proses Produksi"
    secondaryHref="/maklon/proses/"
  />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 55%, var(--accent) 100%);
    color: #fff;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.18;
    background-image:
      radial-gradient(circle at 18% 22%, #fff 0, transparent 42%),
      radial-gradient(circle at 82% 78%, #fff 0, transparent 38%);
  }

  .hero__inner {
    padding-block: clamp(3.5rem, 9vw, 7rem);
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .hero__badge {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.28);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__title {
    margin-top: 1.25rem;
    color: #fff;
    max-width: 22ch;
  }

  .hero__lead {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.9);
    max-width: 54ch;
  }

  .hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.92);
  }

  .hero__points li {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.75);
  }

  .hero__card {
    padding: 2rem;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(4px);
  }

  .hero__card-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
    margin-bottom: 1.25rem;
  }

  .hero__card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
    font-size: 0.9375rem;
    color: #fff;
  }

  .hero__card-row--total {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 2px solid rgb(255 255 255 / 0.35);
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .free {
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    background: #a7f3d0;
    color: #065f46;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .hero__card-foot {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.75);
  }

  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .tier--highlight {
    border-color: var(--brand);
    box-shadow: var(--shadow-lg);
  }

  .tier__flag {
    position: absolute;
    top: -0.75rem;
    left: 1.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--brand);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tier__name {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .tier__range {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }

  .tier--highlight .tier__range {
    color: var(--brand);
  }

  .tier__order {
    margin-top: 0.25rem;
    color: var(--ink-4);
  }

  .tier__cost {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .tier__cost-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .tier--highlight .tier__cost-label {
    color: var(--brand);
  }

  .tier__cost-note {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-4);
  }

  .tier__perks {
    display: grid;
    gap: 0.5rem;
    margin: 1.25rem 0 1.5rem;
    padding: 0;
    flex: 1;
  }

  .tier__perks li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .tier__perks :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--brand);
  }

  .tier__cta {
    margin-top: auto;
  }

  .scope {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .scope__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: var(--brand-50);
    color: var(--brand);
    flex-shrink: 0;
  }

  .scope__icon--out {
    background: var(--bg-muted);
    color: var(--ink-4);
  }

  .scope__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .scope__head h3 {
    font-size: 1.0625rem;
  }

  .scope p {
    font-size: 0.9375rem;
    color: var(--ink-3);
  }

  .split {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  @media (min-width: 62rem) {
    .split {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .conditions {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
  }

  .conditions li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.125rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .conditions :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--brand);
  }

  .callout {
    padding: 2rem;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius-lg);
  }

  .callout__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: #fff;
    color: var(--brand);
    margin-bottom: 1.125rem;
  }

  .callout h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .callout p {
    font-size: 0.9375rem;
    color: var(--brand-dark);
  }

  .callout .btn {
    margin-top: 1.5rem;
  }

  .faqs {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .faq {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    cursor: pointer;
    font-weight: 600;
    color: var(--ink);
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex-shrink: 0;
    color: var(--brand);
    transition: transform var(--transition);
  }

  .faq[open] .faq__icon {
    transform: rotate(90deg);
  }

  .faq p {
    padding: 0 1.25rem 1.25rem;
    font-size: 0.9375rem;
    color: var(--ink-3);
  }

  .booking {
    padding: 2rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .booking__num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .booking h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
  }

  .booking p {
    font-size: 0.9375rem;
    color: var(--ink-3);
  }

  .proof {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 56rem) {
    .proof {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .proof__item {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .proof__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: #fff;
    color: var(--brand);
    flex-shrink: 0;
  }

  .proof__item h3 {
    font-size: 1rem;
    margin-bottom: 0.375rem;
  }

  .proof__item p {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .proof__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand);
  }
</style>
