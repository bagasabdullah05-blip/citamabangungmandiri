---
import SectionHead from './SectionHead.astro';
import { culture, missions, vision } from '../data/cbm-identity';
---

<section class="section section--soft" id="visi-misi">
  <div class="container">
    <SectionHead
      align="center"
      eyebrow="Visi dan Misi"
      title="Arah yang Kami Tuju"
      description="Visi dan misi yang menjadi pegangan dalam setiap keputusan bisnis kami."
    />
    <div class="vm-grid">
      <div class="vm">
        <span class="vm__tag">Visi</span>
        <p class="vm__text">{vision}</p>
      </div>
      <div class="vm">
        <span class="vm__tag">Misi</span>
        <ol role="list" class="vm__list">
          {missions.map((mission) => <li>{mission}</li>)}
        </ol>
      </div>
    </div>
  </div>
</section>

<section class="section" id="budaya">
  <div class="container">
    <SectionHead
      align="center"
      eyebrow="Budaya Kami"
      title="Tujuh Nilai BER-CBM"
      description="Tujuh nilai yang menjadi pegangan seluruh tim dalam bekerja setiap hari."
    />
    <div class="culture">
      {
        culture.map((statement, index) => (
          <article class="culture__item">
            <span class="culture__num">{String(index + 1).padStart(2, '0')}</span>
            <p class="culture__text">{statement}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vm-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .vm-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .vm {
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
  }

  .vm__tag {
    display: inline-block;
    padding: 0.3125rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--brand-50);
    color: var(--brand-dark);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .vm__text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--ink);
    line-height: 1.6;
  }

  .vm__list {
    counter-reset: misi;
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .vm__list li {
    counter-increment: misi;
    position: relative;
    padding-left: 2rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .vm__list li::before {
    content: counter(misi);
    position: absolute;
    left: 0;
    top: 0.0625rem;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand-dark);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .culture {
    display: grid;
    gap: 0.875rem;
  }

  @media (min-width: 40rem) {
    .culture {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .culture {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .culture__item {
    position: relative;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .culture__item:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
  }

  .culture__num {
    display: block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--brand);
    margin-bottom: 0.625rem;
  }

  .culture__item h3 {
    font-size: 1rem;
    margin-bottom: 0.375rem;
  }

  .culture__text {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-2);
    line-height: 1.5;
  }
</style>
