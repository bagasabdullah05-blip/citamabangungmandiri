---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  note?: string;
  primaryExternal?: boolean;
  secondaryExternal?: boolean;
}

const {
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  note,
  primaryExternal = false,
  secondaryExternal = false,
} = Astro.props;

const externalAttrs = (isExternal: boolean) =>
  isExternal ? { target: '_blank', rel: 'noopener' } : {};
---

<section class="cta">
  <div class="container cta__inner" data-reveal data-parallax="0.04">
    <div class="cta__content">
      <h2>{title}</h2>
      {description && <p>{description}</p>}
      {note && <p class="cta__note">{note}</p>}
    </div>
    <div class="cta__actions">
      {primaryHref && primaryLabel && (
        <a
          href={primaryHref}
          class="btn btn--light"
          {...externalAttrs(primaryExternal)}
        >
          {primaryLabel}
          <Icon name="arrow" size={18} />
        </a>
      )}
      {secondaryHref && secondaryLabel && (
        <a
          href={secondaryHref}
          class="btn btn--ghost-light"
          {...externalAttrs(secondaryExternal)}
        >
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--ink);
    color: #fff;
    padding-block: clamp(2.75rem, 6vw, 4rem);
  }

  .cta__inner {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  @media (min-width: 56rem) {
    .cta__inner {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }

  .cta h2 {
    color: #fff;
    max-width: 24ch;
  }

  .cta p {
    margin-top: 0.75rem;
    color: var(--ink-4);
    max-width: 60ch;
  }

  .cta__note {
    font-size: 0.875rem;
    color: var(--brand-light) !important;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 56rem) {
    .cta__actions {
      justify-content: flex-end;
    }
  }
</style>