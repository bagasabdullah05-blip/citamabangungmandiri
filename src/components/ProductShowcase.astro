---
import Icon from './Icon.astro';
import { products } from '../data/herbal-products';
import { site } from '../data/site';

const featured = products.filter((product) => product.featured);
const total = String(featured.length).padStart(2, '0');

const waFor = (name: string) =>
  `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(
    `Halo PT. Citra Bangun Mandiri, saya tertarik maklon ${name}. Bisa info MOQ dan estimasinya?`,
  )}`;
---

<section class="showcase" id="etalase" aria-label="Etalase produk unggulan">
  <div class="container">
    <p class="eyebrow eyebrow--center">Etalase Produk</p>
    <h2 class="showcase__title">Dua Produk Unggulan Kami</h2>
    <p class="showcase__lead">
      Geser ke bawah untuk melihat tiap produk beserta status izin edarnya.
    </p>
  </div>

  <div class="stack" data-showcase>
    {
      featured.map((product, index) => (
        <article
          class="panel"
          data-theme={index % 2 === 0 ? 'purple' : 'green'}
          data-panel
        >
          <span class="panel__num" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="panel__inner">
            <div class="panel__text">
              <p class="panel__count reveal" style="--i: 0">
                {String(index + 1).padStart(2, '0')} / {total}
              </p>
              <p class="reveal" style="--i: 1">
                <span class="panel__badge">{product.category}</span>
                {product.sizes?.length ? (
                  <span class="panel__form">{product.sizes.join(' · ')}</span>
                ) : (
                  product.size && <span class="panel__form">{product.size}</span>
                )}
              </p>
              <h3 class="reveal" style="--i: 2">
                {product.name}
              </h3>
              <div class="panel__certs reveal" style="--i: 3">
                {product.certification.map((cert) => (
                  <span class="panel__chip">
                    <Icon name="shield" size={14} />
                    {cert}
                  </span>
                ))}
              </div>
              {product.regNumber && (
                <p class="panel__reg reveal" style="--i: 4">
                  {product.regNumber}
                </p>
              )}
              <div class="panel__actions reveal" style="--i: 5">
                <a
                  href={waFor(product.name)}
                  class="btn btn--light"
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="whatsapp" size={18} />
                  Tanya Produk Ini
                </a>
                <a href="/maklon/produk/" class="btn btn--ghost">
                  Lihat Katalog
                  <Icon name="arrow" size={18} />
                </a>
              </div>
            </div>
            <div class="panel__art reveal" style="--i: 2">
              {product.photo ? (
                <img
                  src={product.photo}
                  alt={product.name}
                  loading="lazy"
                  class="panel__photo"
                />
              ) : (
                <div class="panel__photo panel__photo--empty" aria-hidden="true">
                  <Icon name="package" size={44} />
                  <span>Foto menyusul</span>
                </div>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  const panels = document.querySelectorAll('[data-panel]');
  if ('IntersectionObserver' in window && panels.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            panels.forEach((p) => p.classList.remove('is-active'));
            entry.target.classList.add('is-active');
          }
        });
      },
      { threshold: 0.45 },
    );
    panels.forEach((panel) => io.observe(panel));
  } else {
    panels.forEach((panel) => panel.classList.add('is-active'));
  }
</script>

<style>
  .showcase {
    padding: 4rem 0 0;
    scroll-margin-top: calc(var(--header-h) + 0.5rem);
  }

  .eyebrow--center {
    justify-content: center;
  }

  .eyebrow--center::after {
    content: '';
    width: 2rem;
    height: 2px;
    background: var(--brand);
  }

  .showcase__title {
    text-align: center;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0.75rem 0;
  }

  .showcase__lead {
    text-align: center;
    color: var(--ink-3);
    max-width: 56ch;
    margin: 0 auto 3rem;
  }

  .stack {
    display: grid;
  }

  .panel {
    position: sticky;
    top: var(--header-h);
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
    border-radius: 1.5rem 1.5rem 0 0;
    box-shadow: 0 -12px 40px rgb(2 6 23 / 0.25);
  }

  .panel[data-theme='purple'] {
    background:
      radial-gradient(60rem 30rem at 85% 10%, rgb(139 92 246 / 0.45), transparent 60%),
      linear-gradient(135deg, #3b1580 0%, #5b21b6 60%, #4c1d95 100%);
  }

  .panel[data-theme='green'] {
    background:
      radial-gradient(60rem 30rem at 15% 10%, rgb(132 204 22 / 0.35), transparent 60%),
      linear-gradient(135deg, #365314 0%, #4d7c0f 60%, #3f6212 100%);
  }

  .panel__num {
    position: absolute;
    right: clamp(0.5rem, 4vw, 3rem);
    top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 18vw, 12rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px rgb(255 255 255 / 0.22);
    pointer-events: none;
    user-select: none;
  }

  .panel__inner {
    width: min(72rem, 100% - 3rem);
    margin-inline: auto;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 3rem 0 4rem;
  }

  @media (min-width: 60rem) {
    .panel__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 3rem;
    }
  }

  .panel__count {
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: rgb(255 255 255 / 0.75);
    margin-bottom: 1rem;
  }

  .panel__badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .panel__form {
    margin-left: 0.75rem;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.8);
    font-weight: 600;
  }

  .panel__text h3 {
    color: #fff;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.05;
    margin: 1rem 0 0.75rem;
  }

  .panel__certs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .panel__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.22);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .panel__reg {
    margin-top: 1rem;
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.8);
  }

  .panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .btn--light {
    background: #fff;
    color: var(--brand-dark);
    border: 1px solid #fff;
  }

  .btn--light:hover {
    background: rgb(255 255 255 / 0.88);
    transform: translateY(-1px);
  }

  .panel[data-theme='green'] .btn--light {
    color: #365314;
  }

  .btn--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.5);
  }

  .btn--ghost:hover {
    background: rgb(255 255 255 / 0.12);
    border-color: #fff;
  }

  .panel__art {
    display: grid;
    place-items: center;
  }

  .panel__photo {
    width: min(100%, 19rem);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    filter: drop-shadow(0 24px 48px rgb(2 6 23 / 0.35));
    background: rgb(255 255 255 / 0.1);
  }

  .panel__photo--empty {
    display: grid;
    place-items: center;
    gap: 0.5rem;
    align-content: center;
    color: rgb(255 255 255 / 0.8);
    font-size: 0.875rem;
    font-weight: 600;
  }

  @media (max-width: 59.99rem) {
    .panel__photo {
      width: min(100%, 13rem);
    }
  }

  .reveal {
    opacity: 0;
    translate: 0 26px;
    transition:
      opacity 600ms ease,
      translate 600ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  .panel.is-active .reveal {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      translate: none;
      transition: none;
    }
  }
</style>
