---
import Icon from './Icon.astro';

/*
 * LangSwitch: pemilih bahasa ID / EN / MS / ZH di pojok kanan atas.
 * Menerjemahkan seluruh teks situs di sisi klien memakai kamus src/i18n.
 * HTML bawaan tetap Bahasa Indonesia (baik untuk SEO).
 */
---

<div class="lang" data-lang-switch>
  <button
    type="button"
    class="lang__btn"
    data-lang-btn
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Language / Bahasa"
  >
    <span data-lang-code>ID</span>
    <Icon name="chevron" size={14} />
  </button>
  <ul class="lang__menu" data-lang-menu hidden role="list">
    <li>
      <button type="button" data-lang-set="id">
        <span class="lang__code">ID</span> Indonesia
      </button>
    </li>
    <li>
      <button type="button" data-lang-set="en">
        <span class="lang__code">EN</span> English
      </button>
    </li>
    <li>
      <button type="button" data-lang-set="ms">
        <span class="lang__code">MS</span> Melayu
      </button>
    </li>
    <li>
      <button type="button" data-lang-set="zh">
        <span class="lang__code">中文</span> Chinese
      </button>
    </li>
  </ul>
</div>

<script>
  import { htmlLang, loadDict, type Lang } from '../i18n/index';

  const STORE_KEY = 'cbm-lang';
  type Active = 'id' | Lang;

  const norm = (s: string) =>
    s
      .replace(/[–—]/g, '-')
      .replace(/\s+/g, ' ')
      .trim();

  const splitEdge = (s: string) => {
    const m = /^(\s*)([\s\S]*?)(\s*)$/.exec(s);
    return { pre: m?.[1] ?? '', core: m?.[2] ?? '', post: m?.[3] ?? '' };
  };

  function stored(): Active {
    try {
      const v = window.localStorage.getItem(STORE_KEY);
      if (v === 'en' || v === 'ms' || v === 'zh') return v;
    } catch {
      /* abaikan */
    }
    return 'id';
  }

  function init() {
    const textItems: { node: Text; orig: string; pre: string; post: string }[] =
      [];
    const attrItems: { el: Element; attr: string; orig: string }[] = [];

    const skip = (el: Element | null) =>
      !el || !!el.closest('[data-lang-switch], script, style, svg, noscript');

    const walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode(node) {
          const parent = node.parentElement;
          if (skip(parent)) return NodeFilter.FILTER_REJECT;
          const key = norm(node.nodeValue ?? '');
          if (!key) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        },
      },
    );

    let current = walker.nextNode();
    while (current) {
      const raw = current.nodeValue ?? '';
      const { pre, core, post } = splitEdge(raw);
      if (core) textItems.push({ node: current as Text, orig: core, pre, post });
      current = walker.nextNode();
    }

    const ATTRS = ['alt', 'placeholder', 'aria-label', 'title'];
    document
      .querySelectorAll('header, main, footer')
      .forEach((root) => {
        root.querySelectorAll('*').forEach((el) => {
          if (skip(el)) return;
          ATTRS.forEach((attr) => {
            const value = el.getAttribute(attr);
            if (value && norm(value)) {
              attrItems.push({ el, attr, orig: norm(value) });
            }
          });
        });
      });

    const codeLabels: Record<Active, string> = {
      id: 'ID',
      en: 'EN',
      ms: 'MS',
      zh: '中文',
    };

    let seq = 0;

    async function apply(lang: Active) {
      const token = ++seq;
      const dict = lang === 'id' ? null : await loadDict(lang as Lang);
      if (token !== seq) return;
      textItems.forEach(({ node, orig, pre, post }) => {
        const hit = dict?.[norm(orig)];
        node.nodeValue = pre + (hit ?? orig) + post;
      });
      attrItems.forEach(({ el, attr, orig }) => {
        const hit = dict?.[orig];
        el.setAttribute(attr, hit ?? orig);
      });
      document.documentElement.lang = lang === 'id' ? 'id' : htmlLang[lang as Lang];
      document
        .querySelectorAll('[data-lang-code]')
        .forEach((el) => {
          el.textContent = codeLabels[lang];
        });
      try {
        window.localStorage.setItem(STORE_KEY, lang);
      } catch {
        /* abaikan */
      }
    }

    document.querySelectorAll('[data-lang-switch]').forEach((box) => {
      const btn = box.querySelector('[data-lang-btn]');
      const menu = box.querySelector('[data-lang-menu]');
      if (!(btn instanceof HTMLElement) || !(menu instanceof HTMLElement)) {
        return;
      }
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        const open = menu.hidden;
        document
          .querySelectorAll('[data-lang-menu]')
          .forEach((m) => (m as HTMLElement).hidden = true);
        document
          .querySelectorAll('[data-lang-btn]')
          .forEach((b) => b.setAttribute('aria-expanded', 'false'));
        menu.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
      });
      menu.querySelectorAll('[data-lang-set]').forEach((opt) => {
        opt.addEventListener('click', () => {
          apply((opt.getAttribute('data-lang-set') ?? 'id') as Active);
          menu.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    });

    document.addEventListener('click', () => {
      document
        .querySelectorAll('[data-lang-menu]')
        .forEach((m) => ((m as HTMLElement).hidden = true));
      document
        .querySelectorAll('[data-lang-btn]')
        .forEach((b) => b.setAttribute('aria-expanded', 'false'));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        document
          .querySelectorAll('[data-lang-menu]')
          .forEach((m) => ((m as HTMLElement).hidden = true));
      }
    });

    apply(stored());  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .lang {
    position: relative;
    flex-shrink: 0;
  }

  .lang__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.7rem;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    cursor: pointer;
  }

  .lang__btn:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 11rem;
    margin: 0;
    padding: 0.375rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: 120;
  }

  .lang__menu[hidden] {
    display: none;
  }

  .lang__menu button {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    padding: 0.55rem 0.7rem;
    background: transparent;
    border: 0;
    border-radius: var(--radius);
    font-size: 0.875rem;
    color: var(--ink-2);
    cursor: pointer;
    text-align: left;
  }

  .lang__menu button:hover {
    background: var(--brand-50);
    color: var(--brand-dark);
  }

  .lang__code {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    font-size: 0.75rem;
    font-weight: 700;
  }
</style>
