---
import Icon from './Icon.astro';
import { footerNav, site } from '../data/site';

const year = new Date().getFullYear();
const socials = [
  { href: site.social.instagram, icon: 'instagram', label: 'Instagram' },
  { href: site.social.linkedin, icon: 'linkedin', label: 'LinkedIn' },
  { href: site.social.facebook, icon: 'facebook', label: 'Facebook' },
].filter((item) => item.href);
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <span class="footer__mark" aria-hidden="true">
            <Icon name="building" size={20} />
          </span>
          <span>
            <strong>{site.legalName}</strong>
            <span class="footer__tag">{site.tagline}</span>
          </span>
        </a>
        <p class="footer__desc">
          Perusahaan herbal yang memproduksi produk berkualitas dan menyediakan
          jasa maklon untuk brand di seluruh Indonesia.
        </p>
        <ul class="footer__social" role="list">
          {
            socials.map((item) => (
              <li>
                <a href={item.href} aria-label={item.label} rel="noopener noreferrer">
                  <Icon name={item.icon} size={18} />
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`https://wa.me/${site.whatsapp}`}
              aria-label="WhatsApp"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" size={18} />
            </a>
          </li>
        </ul>
      </div>

      <div class="footer__nav">
        {
          footerNav.map((group) => (
            <div>
              <h3 class="footer__heading">{group.title}</h3>
              <ul role="list" class="footer__list">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div>
          <h3 class="footer__heading">Hubungi</h3>
          <ul role="list" class="footer__list footer__contact">
            <li>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
            <li>
              <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
            </li>
            <li>{site.address}</li>
            <li>{site.hours}</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {site.legalName}. Seluruh hak dilindungi.</p>
      <p class="footer__note">
       	Sebagian data pada website ini masih berupa contoh dan akan diperbarui.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--ink-4);
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.75rem;
    margin-top: auto;
  }

  .footer__top {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  @media (min-width: 60rem) {
    .footer__top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    }
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    font-family: var(--font-display);
  }

  .footer__mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: var(--brand);
    color: #fff;
    flex-shrink: 0;
  }

  .footer__logo strong {
    display: block;
    font-size: 1.0625rem;
  }

  .footer__tag {
    display: block;
    font-size: 0.75rem;
    color: var(--brand-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .footer__desc {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    max-width: 30rem;
  }

  .footer__social {
    display: flex;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.08);
    color: var(--ink-4);
  }

  .footer__social a:hover {
    background: var(--brand);
    color: #fff;
  }

  .footer__nav {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }

  .footer__heading {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1rem;
  }

  .footer__list {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }

  .footer__list a {
    color: var(--ink-4);
  }

  .footer__list a:hover {
    color: #fff;
  }

  .footer__contact li {
    line-height: 1.5;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 1.75rem;
    font-size: 0.8125rem;
  }

  .footer__note {
    color: var(--ink-4);
  }
</style>